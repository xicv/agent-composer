{
  "roles": {
    "researcher": {
      "provider": "cli",
      "cli": [
        "codex",
        "--search",
        "--ask-for-approval",
        "never",
        "exec",
        "--ephemeral",
        "--sandbox",
        "read-only",
        "-c",
        "model=\"gpt-5.4\""
      ],
      "timeoutMs": 180000,
      "retries": 0
    },
    "coder": {
      "provider": "anthropic",
      "apiKeyEnv": "ANTHROPIC_AUTH_TOKEN",
      "baseUrl": "https://api.z.ai/api/anthropic",
      "model": "glm-5.2"
    },
    "reviewer": {
      "provider": "cli",
      "model": "claude-sonnet-4-6",
      "cli": [
        "claude",
        "-p",
        "--model",
        "claude-sonnet-4-6",
        "--permission-mode",
        "bypassPermissions",
        "--setting-sources",
        "project",
        "--disable-slash-commands",
        "--no-session-persistence",
        "--max-budget-usd",
        "0.50",
        "--tools",
        "Read,Glob,Grep,Bash",
        "--allowedTools",
        "Read,Glob,Grep,Bash(npx tsc --noEmit),Bash(npm test),Bash(npm run test:*),Bash(npx vitest*)"
      ],
      "timeoutMs": 300000,
      "retries": 0
    },
    "reviewerClaude": {
      "provider": "cli",
      "model": "claude-opus-4-8",
      "cli": [
        "claude",
        "-p",
        "--model",
        "claude-opus-4-8",
        "--permission-mode",
        "bypassPermissions",
        "--setting-sources",
        "project",
        "--disable-slash-commands",
        "--no-session-persistence",
        "--max-budget-usd",
        "0.50",
        "--tools",
        "Read,Glob,Grep,Bash",
        "--allowedTools",
        "Read,Glob,Grep,Bash(npx tsc --noEmit),Bash(npm test),Bash(npm run test:*),Bash(npx vitest*)"
      ],
      "timeoutMs": 300000,
      "retries": 0
    },
    "coderCli": {
      "provider": "cli",
      "cli": [
        "codex",
        "exec",
        "--ephemeral",
        "--sandbox",
        "workspace-write",
        "-c",
        "approval_policy=\"never\"",
        "-c",
        "model_reasoning_effort=\"medium\"",
        "-c",
        "model=\"gpt-5.5\""
      ],
      "timeoutMs": 240000,
      "retries": 0
    },
    "oraclePlanner": {
      "provider": "cli",
      "cli": [
        "bash",
        "scripts/oracle-plan-mcp.sh",
        "--mode",
        "auto",
        "--"
      ],
      "timeoutMs": 1200000,
      "retries": 0,
      "maxResultChars": 14000
    }
  },
  "profiles": {
    "glm-coder": {
      "roles": {
        "coder": {
          "provider": "anthropic",
          "apiKeyEnv": "ANTHROPIC_AUTH_TOKEN",
          "baseUrl": "https://api.z.ai/api/anthropic",
          "model": "glm-5.2-profile"
        }
      },
      "fallbacks": {
        "reviewerClaude": [
          "reviewer"
        ]
      }
    }
  },
  "spendAuthorization": {
    "mode": "auto",
    "maxUsdPerSession": 50,
    "maxUsdPerCall": 0.5
  },
  "codexReview": {
    "enabled": true,
    "triggers": {
      "preCommit": true,
      "postPlan": true
    },
    "preCommitCommand": "adversarial-review",
    "postPlanCommand": "adversarial-review",
    "mode": "auto",
    "execution": "background",
    "scope": "auto",
    "base": "main",
    "model": "gpt-5.5",
    "preCommitHook": {
      "enabled": true,
      "blockOnSeverity": "high",
      "timeoutMs": 180000,
      "failClosed": false
    },
    "warmCache": {
      "enabled": true,
      "maxAgeMinutes": 30,
      "timeoutMs": 300000
    },
    "notify": {
      "desktop": false
    }
  },
  "codexRescue": {
    "enabled": true,
    "mode": "ask",
    "model": "gpt-5.4-mini"
  },
  "codexLifecycle": {
    "enabled": true,
    "mode": "auto",
    "execution": "background",
    "model": "gpt-5.4-mini",
    "triggers": {
      "postResearch": false,
      "postPlan": true,
      "postCodeApply": true,
      "postTestFailure": true,
      "afterFailedAttempts": true,
      "preCommit": false,
      "stopWarm": false
    },
    "thresholds": {
      "minScore": 60,
      "minExpectedOutputTokens": 500,
      "minChangedFiles": 2,
      "minDiffLines": 80,
      "failedAttempts": 2
    },
    "fallback": {
      "enabled": true,
      "order": [
        "reviewerClaude",
        "reviewer",
        "coder"
      ]
    },
    "totalWallClockMs": 900000
  }
}
