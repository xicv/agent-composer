{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": ["Bash", "Edit", "Write", "NotebookEdit"],
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Task",
      "mcp__composer__composer_research",
      "mcp__composer__composer_code",
      "mcp__composer__composer_review"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/boundary_guard.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/learn.sh"
          }
        ]
      }
    ]
  },
  "mcpServers": {
    "composer": {
      "type": "stdio",
      "command": "npx",
      "args": ["tsx", "$CLAUDE_PROJECT_DIR/src/index.ts"]
    }
  }
}
