{
  "_note": "Copy to .claude/settings.local.json to enable dispatch_guard Phase 2 hints. It logs Task/Agent dispatches, emits deterministic dispatch-hint additionalContext (route/class/tier/size/reasoning/recommendDispatch) computed by src/cli/dispatch-hint.ts, and never denies except the existing destructive-tiny rule. Set COMPOSER_ENABLED=0 or touch ~/.claude/composer.disabled to soft-disable Composer hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Task|Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/dispatch_guard.sh"
          }
        ]
      }
    ]
  }
}
